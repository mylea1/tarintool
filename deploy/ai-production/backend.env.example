# Use staging while the shared 123/1234 test accounts remain enabled.
NODE_ENV=staging
KILO_HOST=127.0.0.1
KILO_PORT=8790
KILO_PUBLIC_BASE_URL=https://api.kilostrength.cn
KILO_ALLOWED_ORIGINS=

KILO_DATA_DIR=/var/lib/kilo
KILO_DATABASE_PATH=/var/lib/kilo/kilo.sqlite3
KILO_MEDIA_DIR=/var/lib/kilo/media
KILO_MAX_UPLOAD_BYTES=262144000
KILO_SESSION_TTL_DAYS=30

# Generate different values with: openssl rand -hex 32
KILO_SESSION_PEPPER=replace-with-64-hex-characters
KILO_GPU_API_KEY=replace-with-another-64-hex-value

KILO_ENABLE_TEST_ADMIN=true
KILO_TEST_ADMIN_IDENTIFIER=1234
KILO_TEST_ADMIN_PASSWORD=1234
KILO_ENABLE_TEST_MEMBER=true
KILO_TEST_MEMBER_IDENTIFIER=123
KILO_TEST_MEMBER_PASSWORD=123
KILO_ENABLE_PASSWORD_REGISTRATION=false

DEEPSEEK_API_KEY=replace-with-a-new-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=disabled
KILO_AI_MAX_CONCURRENCY=10
KILO_AI_QUEUE_LIMIT=40
KILO_AI_REQUEST_TIMEOUT_SECONDS=60

APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
