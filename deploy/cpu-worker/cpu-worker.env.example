KILO_API_BASE=https://api.kilostrength.cn
KILO_GPU_API_KEY=must-match-the-aliyun-backend-64-hex-secret

KILO_INFERENCE_DEVICE=cpu
KILO_CPU_THREADS=4
KILO_INFERENCE_IMAGE_SIZE=512
KILO_INFERENCE_FPS=10
KILO_MAX_VIDEO_SECONDS=45
KILO_MAX_VIDEO_DIMENSION=960
KILO_POSE_CONFIDENCE=0.35

KILO_POLL_SECONDS=5
KILO_HEARTBEAT_SECONDS=30
KILO_HTTP_TIMEOUT_SECONDS=180
KILO_LOG_LEVEL=INFO
YOLO_CONFIG_DIR=/tmp
