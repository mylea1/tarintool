# Copy to .agent.env. Actual credentials and records must remain uncommitted.
KILO_HOST=127.0.0.1
KILO_PORT=8792
KILO_PUBLIC_BASE_URL=http://127.0.0.1:8792
NODE_ENV=development
KILO_ENABLE_TEST_MEMBER=true
KILO_ENABLE_TEST_ADMIN=false
KILO_AGENT_BACKEND_URL=https://api.kilostrength.cn

# The Web UI uses your external AI through MCP; no model key is required.
# Disable the trial account for a real deployment.
# Keep HTTPS and a persistent session pepper for remote access.
# Optional: override KILO_DATA_DIR, KILO_DATABASE_PATH, KILO_MEDIA_DIR
# with your own deployment paths. Default: project .agent-local directory.
