{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kilo.local/contracts/mobile-recognition.json",
  "title": "KILO mobile recognition request/response boundary",
  "type": "object",
  "required": ["request", "result"],
  "properties": {
    "request": {
      "type": "object",
      "required": ["exerciseId", "camera"],
      "properties": {
        "exerciseId": {"type": "string", "minLength": 1},
        "camera": {"type": "string", "minLength": 1},
        "mediaId": {"type": "string"},
        "offline": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["status", "confidence", "summary", "events"],
      "properties": {
        "status": {"enum": ["complete", "low-confidence", "offline", "error"]},
        "assessment": {"enum": ["assessable", "insufficient_evidence"]},
        "evidenceReason": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "repetitions": {
          "type": "integer",
          "minimum": 0,
          "deprecated": true,
          "description": "仅用于兼容旧结果，不得用于用户问题定位文案。"
        },
        "summary": {"type": "string"},
        "events": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "code", "label", "startMs", "peakMs", "endMs", "displayTime", "explanation"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "code": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "startMs": {"type": "integer", "minimum": 0},
              "peakMs": {"type": "integer", "minimum": 0},
              "endMs": {"type": "integer", "minimum": 0},
              "displayTime": {"type": "string", "pattern": "^[0-9]{2,}:[0-9]{2}\\.[0-9]$"},
              "stage": {"type": "string"},
              "category": {"enum": ["primary_form", "stability_compensation", "evidence_camera", "count_segmentation"]},
              "evidenceQuality": {"enum": ["observed", "inferred_direction", "mixed"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "measurements": {"type": "object"},
              "explanation": {"type": "string"},
              "evidenceImageUrl": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        },
        "limitations": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "object", "additionalProperties": true},
        "evidence": {
          "type": "object",
          "properties": {
            "level": {"enum": ["full_cycle", "partial_cycle", "local_segment", "mismatch", "none"]},
            "canJudgePrimary": {"type": "boolean"},
            "canCountRepetitions": {"type": "boolean"},
            "visiblePhases": {"type": "array", "items": {"type": "string"}},
            "evaluatedRules": {"type": "array", "items": {"type": "string"}},
            "skippedRules": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "actionCompatibility": {"type": "object", "additionalProperties": true},
        "ruleCoverage": {"type": "object", "additionalProperties": true},
        "aiReview": {"type": ["object", "null"], "additionalProperties": true},
        "aiReviewError": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
