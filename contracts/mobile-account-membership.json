{
  "version": "v1",
  "status": "contract-boundary",
  "prototypeNote": "The Flutter local repository is runnable without this service. Production implementations must enforce authentication, role checks, and atomic usage updates server-side.",
  "endpoints": {
    "phoneLogin": { "method": "POST", "path": "/v1/auth/phone/login", "request": ["identifier", "password"], "response": ["user", "session"] },
    "appleLogin": { "method": "POST", "path": "/v1/auth/apple", "request": ["identityToken"], "response": ["user", "session"] },
    "googleLogin": { "method": "POST", "path": "/v1/auth/google", "request": ["idToken"], "response": ["user", "session"] },
    "entitlements": { "method": "GET", "path": "/v1/me/entitlements", "response": ["membership", "membershipExpiresAt", "trialStartedAt", "trialExpiresAt", "trialWorkoutId", "trialActive", "trialEligible", "trialClaimed", "aiRemaining", "aiDailyLimit", "recognitionRemaining"] },
    "membershipTrialActivate": { "method": "POST", "path": "/v1/membership/trial/activate", "request": ["workoutId", "durationSeconds", "effectiveSets"], "response": ["activated", "idempotent", "reason", "entitlement"], "validation": "authenticated; durationSeconds >= 1800 and effectiveSets >= 1 for first activation; server grants 72 hours once per account" },
    "redeem": { "method": "POST", "path": "/v1/redemptions/redeem", "request": ["code"], "atomic": true },
    "consume": { "method": "POST", "path": "/v1/usage/consume", "request": ["kind", "requestId"], "atomic": true, "rollbackOnRemoteFailure": true },
    "workoutReward": { "method": "POST", "path": "/v1/rewards/workout-completed", "request": ["workoutId"], "idempotentBy": "workoutId" },
    "grantMembership": { "method": "POST", "path": "/v1/admin/memberships/grant", "request": ["identifier", "plan"], "requiresRole": "admin" },
    "generateCode": { "method": "POST", "path": "/v1/admin/redemption-codes", "request": ["plan"], "requiresRole": "admin" }
  },
  "plans": ["oneMonth", "yearly"],
  "legacyPlans": ["threeMonths", "forever"],
  "purchaseProducts": {
    "com.kilostrength.pro.monthly": { "plan": "oneMonth", "currency": "CNY", "amountMinor": 1200 },
    "com.kilostrength.pro.yearly": { "plan": "yearly", "currency": "CNY", "amountMinor": 12800 },
    "com.kilostrength.pro.quarterly": { "plan": "threeMonths", "legacyOnly": true }
  },
  "usageRules": {
    "free": { "aiDaily": 3, "recognitionInitial": 5, "recognitionWeekly": 1 },
    "member": { "aiDaily": 20, "recognitionWeekly": 3, "recognitionUnlimited": false }
  },
  "errors": ["unauthenticated", "admin_required", "not_configured", "quota_exhausted", "invalid_code", "code_already_used"]
}
