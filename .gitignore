.gstack/
.playwright-cli/
.dart_tool/
output/
design-previews/kilo-themes/generated/*.png
design-previews/kilo-themes/preview-*.png

# Local UI previews derived from user-provided exercise videos stay on-device.
design-previews/recognition-coach-summary-assets/
design-previews/recognition-coach-summary-v2.html

# Local credentials and Apple signing files must stay outside Git.
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision

# Downloaded ML weights are deployment artifacts, not source files.
gpu-worker/*.pt
gpu-worker/.venv-local/

# Python bytecode and local interpreter caches are not deployment inputs.
__pycache__/
*.py[cod]
