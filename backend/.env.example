# Network
KILO_HOST=127.0.0.1
KILO_PORT=8790
KILO_PUBLIC_BASE_URL=http://127.0.0.1:8790
KILO_ALLOWED_ORIGINS=http://127.0.0.1:4174

# Persistent data. Keep media outside the source tree in production.
KILO_DATA_DIR=./data
KILO_DATABASE_PATH=./data/kilo.sqlite3
KILO_MEDIA_DIR=./data/media
KILO_MAX_UPLOAD_BYTES=262144000
KILO_MAX_JSON_BYTES=2097152
KILO_SESSION_TTL_DAYS=30
KILO_GPU_CLAIM_TIMEOUT_SECONDS=900

# Sessions and internal GPU worker authentication.
# Generate both with at least 32 random bytes before production deployment.
KILO_SESSION_PEPPER=replace-with-a-long-random-value
KILO_GPU_API_KEY=replace-with-a-different-long-random-value

# Test-only administrator. Disable in production.
KILO_ENABLE_TEST_ADMIN=true
KILO_TEST_ADMIN_IDENTIFIER=1234
KILO_TEST_ADMIN_PASSWORD=1234
KILO_ENABLE_TEST_MEMBER=true
KILO_TEST_MEMBER_IDENTIFIER=123
KILO_TEST_MEMBER_PASSWORD=123
# Password registration is off by default; enable only in development/test.
KILO_ENABLE_PASSWORD_REGISTRATION=false

# DeepSeek is only called by this service. Revoke any key previously exposed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# V4 Flash defaults to thinking mode. Disable it for lower-latency coach chat.
DEEPSEEK_THINKING_MODE=disabled
# At most 10 requests call DeepSeek at the same time. The next 40 wait in FIFO
# order; requests beyond that fail fast with HTTP 503 `ai_busy`.
KILO_AI_MAX_CONCURRENCY=10
KILO_AI_QUEUE_LIMIT=40
KILO_AI_REQUEST_TIMEOUT_SECONDS=60

# Provider login verification. Leave blank to return provider_not_configured.
APPLE_CLIENT_ID=
# App Store Connect 的 App 专用共享密钥，仅供服务端校验 StoreKit 1 收据。
# 不得写入 Flutter、Git 或客户端构建变量。
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=com.kilostrength.kiloStrength
GOOGLE_CLIENT_ID=
